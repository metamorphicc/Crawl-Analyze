{
  "name": "crawlspider",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "doctor": "node tools/doctor.mjs",
    "doctor:services": "node tools/doctor.mjs --services",
    "browser:check": "node tools/browser-check.mjs",
    "toolchain:check": "tsc --noEmit && tsx tools/toolchain-check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --conditions=development --import tsx packages/storage/src/migrate.ts",
    "dev:api": "node --conditions=development --import tsx apps/api/src/index.ts",
    "dev:worker": "node --conditions=development --import tsx apps/worker/src/index.ts",
    "dev:bot": "node --conditions=development --import tsx apps/bot/src/index.ts",
    "dev:web": "npm run dev --workspace @crawlspider/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "dotenv": "18.0.6"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "uuid": "11.1.1"
  }
}
