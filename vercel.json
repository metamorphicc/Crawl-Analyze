{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "npm ci --prefix ../..",
      "buildCommand": "node ../../tools/build-service.mjs web",
      "outputDirectory": "dist",
      "devCommand": "node ../../tools/dev-service.mjs web",
      "rewrites": [
        { "source": "/token/:mint", "destination": "/index.html" },
        { "source": "/report/:id", "destination": "/index.html" },
        { "source": "/status", "destination": "/index.html" },
        { "source": "/methodology", "destination": "/index.html" },
        { "source": "/watchlist", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
