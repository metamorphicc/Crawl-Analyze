# Local infrastructure. tools/setup-local.mjs generates a local password without printing it.
POSTGRES_USER=crawlspider
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=crawlspider
POSTGRES_PORT=55432
REDIS_PORT=56379
# Optional mirror override for environments where Docker Hub is unavailable.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
DATABASE_URL=postgresql://crawlspider:replace-with-local-password@127.0.0.1:55432/crawlspider
REDIS_URL=redis://127.0.0.1:56379

# Fill locally before live provider validation. Never paste credentials into chat or commit .env.
HELIUS_API_KEY=
SOLANA_RPC_URL=
SOLANA_FALLBACK_RPC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# Webhook mode requires an HTTPS URL ending in /telegram and a random 32–256 character secret.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PORT=3002
TELEGRAM_BOT_USERNAME=

# Public configuration. No secrets may use a VITE_ prefix.
API_PORT=3001
API_HOST=127.0.0.1
# Set true only when a trusted HTTPS tunnel/proxy runs on this same PC. Keep the listener loopback-only.
API_TRUST_LOOPBACK_PROXY=false
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
# Public hybrid hosting: see docs/VERCEL_PC.md. Set VITE_API_URL on Vercel to your HTTPS API origin.
# On the PC set NODE_ENV=production, WEB_ORIGIN/PUBLIC_WEB_URL to the website's HTTPS origin,
# API_TRUST_LOOPBACK_PROXY=true. Provider, Telegram, database and Redis secrets stay on the PC.

# Limits are starting defaults, not measured production guarantees.
SCAN_CONCURRENCY=4
SCAN_QUEUE_LIMIT=200
SCAN_IP_MINUTE_LIMIT=6
SCAN_IP_DAILY_LIMIT=100
SCAN_CACHE_MS=60000
SSE_CONNECTION_LIMIT=100
SCAN_PREVIEW_DEADLINE_MS=15000
SCAN_DEEP_DEADLINE_MS=120000
PROVIDER_REQUEST_TIMEOUT_MS=5000
PROVIDER_MAX_RPS=5
PROVIDER_DAILY_REQUEST_LIMIT=50000
MAX_HOLDER_PAGES=200
MAX_HISTORY_OWNERS=100
ALERT_RECHECK_INTERVAL_MS=900000
WATCHLIST_LIMIT=20
LOG_LEVEL=info
